ata, na qual# Desenvolvimento local. Copie para .env; nunca comite senhas reais.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Vazio mantém SQLite local; na Vercel as duas URLs são obrigatórias.
# Use URLs do mesmo banco/branch Neon com ?sslmode=require.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Opcional: SMTP com STARTTLS, quando houver envio de e-mail.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=webmaster@localhost
